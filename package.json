{
  "name": "writara",
  "productName": "Writara",
  "private": true,
  "version": "0.2.0",
  "description": "自然书写，即刻呈现 —— Typora 式的即时渲染 Markdown 编辑器",
  "author": "NBullet <nbullet@126.com>",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "npm run typecheck && vite build",
    "build:renderer": "vite build --mode desktop",
    "build:main": "vite build --config vite.electron.config.ts",
    "build:electron": "npm run typecheck && npm run build:renderer && npm run build:main",
    "package": "npm run build:electron && electron-builder",
    "release": "npm run build:electron && electron-builder --win nsis --publish always",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "templates:docx": "node scripts/make-docx-templates.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "iconv-lite": "^0.6.3",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBullet/Writara.git"
  }
}
